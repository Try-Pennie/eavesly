INTERNAL_API_KEY=your_secure_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_GATEWAY_ID=your_gateway_id
CF_AIG_TOKEN=your_aig_token

# Twilio transcription path (POST /api/v1/evaluate/{module}/from-recording).
# Only needed if you exercise the from-recording endpoint; the transcript-based
# endpoints work without these. DEEPGRAM_MODEL has a default (nova-3) in wrangler.toml.
DEEPGRAM_API_KEY=your_deepgram_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
