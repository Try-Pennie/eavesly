{
  "name": "eavesly",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env staging && wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:psai245-gate2-db": "bash scripts/test-psai245-gate2-migration.sh",
    "test:psai245-gate3-db": "bash scripts/test-psai245-gate3-migration.sh",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "eval:disposition": "tsx scripts/eval-disposition-models.ts",
    "eval:achieve-wc": "tsx scripts/eval-achieve-wc-qa.ts",
    "eval:achieve-wc:cf": "cfp env pennie -- bash -c 'CF_ACCOUNT_ID=3e7f907a9c19e51417873e2cce4fbc5c CF_GATEWAY_ID=eavesly CF_AIG_TOKEN=$CLOUDFLARE_API_TOKEN npm run eval:achieve-wc'",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "hono": "^4.6.0",
    "openai": "^4.77.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.12",
    "@cloudflare/workers-types": "^4.20241218.0",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.65.0"
  }
}
